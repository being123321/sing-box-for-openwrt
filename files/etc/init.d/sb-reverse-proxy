#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=12
start_service() {
    [ -s /etc/sb-router/reverse-proxy.cfg ] || return 0
    grep -q '^frontend ' /etc/sb-router/reverse-proxy.cfg || return 0
    /usr/sbin/haproxy -c -q -f /etc/sb-router/reverse-proxy.cfg || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/haproxy -W -db -f /etc/sb-router/reverse-proxy.cfg
    procd_set_param reload_signal USR2
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() {
    /usr/sbin/haproxy -c -q -f /etc/sb-router/reverse-proxy.cfg && procd_send_signal sb-reverse-proxy '*' USR2
}
