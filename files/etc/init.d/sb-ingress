#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=11
start_service() {
    [ -x /etc/sb-router/core ] || { logger -t sb-router 'core missing for this architecture; install it from LuCI'; return 1; }
    [ -s /etc/sb-router/active.json ] || return 1
    procd_open_instance
    procd_set_param command /etc/sb-router/core run -D /etc/sb-router -c /etc/sb-router/active.json
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

