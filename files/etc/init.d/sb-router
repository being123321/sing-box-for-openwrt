#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
start_service() {
    [ -x /etc/sb-router/core ] || { logger -t sb-router 'core missing for this architecture; install it from LuCI'; return 1; }
    [ -s /etc/sb-router/tun.json ] || return 1
    pidof honk-core >/dev/null && return 1
    touch /tmp/sb-router-wanted
    procd_open_instance
    procd_set_param command /etc/sb-router/core run -D /etc/sb-router -c /etc/sb-router/tun.json
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

service_started() { /etc/sb-router/dns-hook up; }

service_stopped() { rm -f /tmp/sb-router-wanted; /etc/sb-router/dns-hook down; }


