#!/usr/bin/python3
import base64, fcntl, hashlib, json, os, pathlib, re, secrets, shutil, subprocess as sp, sys, tempfile, time, urllib.parse

from router_platform import lan_address, api_url
LAN = lan_address()
D = pathlib.Path('/etc/sb-router')
profiles = D / 'profiles'
profiles.mkdir(mode=0o700, exist_ok=True)
os.umask(0o077)

PROXY_TYPES = {'hysteria2', 'vless', 'vmess', 'trojan', 'shadowsocks', 'tuic', 'hysteria', 'anytls', 'shadowtls', 'snell'}
NON_NODE_TAGS = {'DIRECT', 'REJECT', 'PROXY', 'AUTO', 'proxy', 'direct', 'block'}
BASE_FILE = D / 'base.json'
BASE_RULES = D / 'rules' / 'base'
BASE_RULE_URLS = {
    'cn': 'https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs',
    'gfw': 'https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/gfw.srs',
    'geoip-cn': 'https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs',
}
PANELS = [
    {'id': 'official', 'name': 'SagerNet 官方面板'},
    {'id': 'yacd', 'name': 'Yacd（第三方）'},
    {'id': 'custom', 'name': '自定义地址'},
]


def save(path, data):
    tmp = path.with_suffix('.tmp')
    tmp.write_bytes(data)
    os.replace(tmp, path)


def fetch(url):
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != 'https' or not parsed.hostname:
        raise ValueError('需要 HTTPS 链接')
    for extra in (['--proxy', 'http://127.0.0.1:18081'], ['--noproxy', '*']):
        r = sp.run(['curl', '-4fsSL', *extra, '--proto', '=https', '--proto-redir', '=https',
                    '--connect-timeout', '5', '--max-time', '40', '--max-filesize', '33554432',
                    '-A', 'SFA (sing-box 1.15.0-alpha.13)', url], capture_output=True)
        if r.returncode == 0:
            return r.stdout
    raise ValueError('下载失败：' + parsed.hostname)


def validate(name):
    if not re.fullmatch(r'[\w.-]{1,64}', name) or name.startswith('.'):
        raise ValueError('配置名称无效')


def check(cfg):
    p = D / 'candidate.json'
    save(p, json.dumps(cfg, ensure_ascii=False).encode())
    r = sp.run([str(D / 'core'), 'check', '-D', str(D), '-c', str(p)], capture_output=True)
    if r.returncode:
        raise ValueError('sing-box 校验失败 ' + r.stderr.decode(errors='replace')[-260:])
    return p


def render(src):
    cfg = json.loads(src)
    cfg['inbounds'] = [dict(type='socks', tag='lan-forward', listen='127.0.0.1', listen_port=18082),
                       dict(type='direct', tag='router-dns', listen='127.0.0.1', listen_port=15353)]
    route = cfg.setdefault('route', {})
    route['auto_detect_interface'] = True
    route['default_mark'] = 0x2024
    route.setdefault('rules', []).insert(0, {'inbound': 'router-dns', 'action': 'hijack-dns'})
    dns = cfg.setdefault('dns', {})
    dns.setdefault('rules', [])
    dns.setdefault('servers', [])
    legacy_path = D / 'before-cutover' / 'original-sing-box.json'
    if not legacy_path.exists():
        legacy_path = D / 'ingress-extra.json'
    legacy = json.loads(legacy_path.read_bytes()) if legacy_path.exists() else {
        'inbounds': [dict(type='http',tag='local-http',listen='127.0.0.1',listen_port=18081)],
        'outbounds': [dict(type='direct',tag='ingress-direct')],
        'route': {'final':'ingress-direct'},
        'dns': {'servers':[dict(type='udp',tag='bootstrap-local',server='223.5.5.5')]}}
    tags = [x['tag'] for x in legacy['inbounds']]
    old_final = legacy['route']['final']
    if any(x.get('tag') in tags for x in cfg['inbounds']) or any(x.get('tag') == old_final for x in cfg['outbounds']):
        raise ValueError('旧服务标签冲突')
    for inbound in legacy['inbounds']:
        tls = inbound.get('tls', {})
        if 'acme' in tls:
            tls['certificate_provider'] = {'type': 'acme', **tls.pop('acme')}
    cfg['inbounds'].extend(legacy['inbounds'])
    cfg['outbounds'].extend(legacy['outbounds'])
    cfg['dns']['servers'].extend(legacy['dns']['servers'])
    route.setdefault('default_domain_resolver', cfg['dns']['servers'][0]['tag'])
    for rs in route.get('rule_set', []):
        if rs.get('type') != 'remote':
            continue
        raw = fetch(rs['url'])
        if rs.get('format') == 'source':
            json.loads(raw)
        directory = D / 'rules'
        directory.mkdir(exist_ok=True)
        target = directory / (hashlib.sha256(raw).hexdigest() + ('.srs' if rs.get('format') == 'binary' else '.json'))
        if not target.exists():
            save(target, raw)
        tag, fmt = rs['tag'], rs.get('format', 'binary')
        rs.clear()
        rs.update(type='local', tag=tag, format=fmt, path=str(target))
    for x in cfg.get('outbounds', []):
        if x.get('tag') == 'PROXY' and x['type'] == 'selector':
            x['interrupt_exist_connections'] = True

    token = D / 'token'
    if not token.exists():
        save(token, secrets.token_urlsafe(32).encode())
    ex = cfg.setdefault('experimental', {})
    ex['cache_file'] = {'enabled': True, 'path': str(D / 'cache.db')}
    ex['clash_api'] = {'external_controller': LAN + ':9090', 'external_ui': str(D / 'ui'),
                       'secret': token.read_text(), 'access_control_allow_origin': ['http://' + LAN + ':9090', 'http://' + LAN + ':9091', 'http://' + LAN + ':9092', 'http://' + LAN + ':9093', 'http://' + LAN + ':9094']}
    cfg['services'] = [s for s in cfg.get('services', []) if s.get('tag') != 'router-dashboard']
    cfg['services'].append(dict(type='api', tag='router-dashboard', listen=LAN, listen_port=9091,
                                secret=token.read_text(),
                                access_control_allow_origin=['http://' + LAN + ':9090', 'http://' + LAN + ':9091', 'http://' + LAN + ':9092', 'http://' + LAN + ':9093', 'http://' + LAN + ':9094'], dashboard=str(D / 'ui')))
    cfg['dns']['rules'].insert(0, dict(query_type=['AAAA'], action='predefined', rcode='NOERROR'))
    settings = json.loads((D/'system.json').read_text()) if (D/'system.json').exists() else {}
    domains = settings.get('ipv6_direct_domains',[])
    if domains and any(x.get('tag')=='daed-dns' for x in cfg['dns']['servers']):
        cfg['dns']['rules'].insert(0, dict(domain_suffix=domains, query_type=['AAAA'], action='route', server='daed-dns'))
    return check(cfg)


def healthy():
    for _ in range(20):
        r = sp.run(['curl', '-fsS', '--max-time', '2', '-H', 'Authorization: Bearer ' + (D / 'token').read_text(),
                    api_url('/version')], capture_output=True)
        if r.returncode == 0:
            return True
        time.sleep(1)
    return False


def base_mode():
    if BASE_FILE.exists():
        try:
            mode = json.loads(BASE_FILE.read_text()).get('mode', 'mainland')
            return mode if mode in ('mainland', 'gfw') else 'mainland'
        except Exception:
            pass
    return 'mainland'


def set_base_mode(mode):
    if mode not in ('mainland', 'gfw'):
        raise ValueError('分流方式无效')
    old = BASE_FILE.read_bytes() if BASE_FILE.exists() else None
    save(BASE_FILE, json.dumps({'mode': mode}, ensure_ascii=False).encode())
    try:
        if active_name() == 'base':
            install('base', True)
    except Exception:
        if old is None:
            BASE_FILE.unlink(missing_ok=True)
        else:
            save(BASE_FILE, old)
        raise
    return {'ok': True, 'mode': mode}


def base_rule(name):
    BASE_RULES.mkdir(parents=True, exist_ok=True)
    target = BASE_RULES / (name + '.srs')
    if target.exists() and target.stat().st_size > 0:
        return str(target)
    url = BASE_RULE_URLS[name]
    raw = None
    for candidate in (url, 'https://gh-proxy.com/' + url):
        try:
            raw = fetch(candidate)
            break
        except Exception:
            continue
    if not raw or len(raw) < 100:
        raise ValueError('规则集下载失败：' + name)
    save(target, raw)
    return str(target)


def base_config(nodes, mode='mainland'):
    if not nodes:
        raise ValueError('基础配置还没有节点，请先添加或从订阅导入节点')
    gfw = mode == 'gfw'
    tags = [n['tag'] for n in nodes]
    sets = [dict(type='local', tag='gfw', format='binary', path=base_rule('gfw'))] if gfw else [
        dict(type='local', tag='cn', format='binary', path=base_rule('cn')),
        dict(type='local', tag='geoip-cn', format='binary', path=base_rule('geoip-cn'))]
    rules = [{'action': 'sniff'}, {'protocol': 'dns', 'action': 'hijack-dns'},
             {'ip_is_private': True, 'action': 'route', 'outbound': 'DIRECT'}]
    if gfw:
        rules.append({'rule_set': 'gfw', 'action': 'route', 'outbound': 'PROXY'})
    else:
        rules.append({'rule_set': 'cn', 'action': 'route', 'outbound': 'DIRECT'})
        rules.append({'action': 'resolve'})
        rules.append({'rule_set': 'geoip-cn', 'action': 'route', 'outbound': 'DIRECT'})
    dns_rules = ([{'rule_set': 'gfw', 'server': 'dns-remote'}] if gfw
                 else [{'rule_set': 'cn', 'server': 'dns-local'}])
    cfg = {
        'outbounds': [
            dict(type='selector', tag='PROXY', outbounds=['AUTO'] + tags, default='AUTO',
                 interrupt_exist_connections=True),
            dict(type='urltest', tag='AUTO', outbounds=tags, url='https://www.gstatic.com/generate_204',
                 interval='1m', tolerance=50),
        ] + [json.loads(json.dumps(n)) for n in nodes] + [dict(type='direct', tag='DIRECT'),
                                                         dict(type='block', tag='REJECT')],
        'dns': {
            'servers': [dict(type='udp', tag='dns-local', server='223.5.5.5'),
                        dict(type='https', tag='dns-remote', server='1.1.1.1', path='/dns-query', detour='PROXY')],
            'rules': dns_rules,
            'final': 'dns-local' if gfw else 'dns-remote',
        },
        'route': {
            'rules': rules,
            'rule_set': sets,
            'final': 'DIRECT' if gfw else 'PROXY',
            'auto_detect_interface': False,
            'default_domain_resolver': 'dns-local',
        },
    }
    return cfg


def node_objects(cfg):
    out = []
    for x in cfg.get('outbounds', []):
        if x.get('type') in PROXY_TYPES and x.get('tag') not in NON_NODE_TAGS:
            out.append(json.loads(json.dumps(x)))
    return out


def base_all_nodes(obj):
    items = []
    for n in obj.get('nodes') or []:
        items.append((n, ''))
    for sub in obj.get('subs') or []:
        for n in sub.get('nodes') or []:
            items.append((n, sub.get('name') or '订阅'))
    seen = set()
    out = []
    for n, source in items:
        node = json.loads(json.dumps(n))
        base = node.get('tag') or node.get('server') or 'node'
        tag = base
        i = 2
        while tag in seen:
            tag = f'{base}-{i}'
            i += 1
        node['tag'] = tag
        seen.add(tag)
        out.append((node, source))
    return out


def base_sub_add(name, url):
    name = (name or '').strip() or urllib.parse.urlsplit(url).hostname or 'subscription'
    if not re.fullmatch(r'[\w.-]{1,64}', name):
        raise ValueError('订阅名称无效')
    nodes = sub_parse(fetch(url).decode('utf-8', 'replace'))
    if not nodes:
        raise ValueError('订阅里没有可用节点')
    path = profiles / 'base.json'
    ensure_base()
    obj = json.loads(path.read_bytes())
    subs = obj.setdefault('subs', [])
    subs[:] = [x for x in subs if x.get('name') != name]
    subs.append({'name': name, 'url': url, 'nodes': nodes})
    obj['nodeCount'] = len(base_all_nodes(obj))
    save(path, json.dumps(obj, ensure_ascii=False).encode())
    selected = (D / 'selected').read_text().strip() if (D / 'selected').exists() else ''
    if selected == 'base':
        install('base', True)
    return {'ok': True, 'nodes': len(nodes)}


def base_sub_list():
    ensure_base()
    obj = json.loads((profiles / 'base.json').read_bytes())
    return {'subs': [{'name': x.get('name', ''), 'url': x.get('url', ''),
                      'nodes': len(x.get('nodes') or [])} for x in obj.get('subs') or []]}


def base_sub_del(name):
    obj = read_obj('base')
    before = len(obj.get('subs') or [])
    obj['subs'] = [x for x in obj.get('subs') or [] if x.get('name') != name]
    if len(obj['subs']) == before:
        raise ValueError('订阅不存在')
    if base_all_nodes(obj):
        write_profile('base', obj)
    elif active_name() == 'base':
        raise ValueError('正在使用的基础配置至少保留一个节点')
    else:
        obj['nodeCount'] = 0
        save(profiles / 'base.json', json.dumps(obj, ensure_ascii=False).encode())
    return {'ok': True}


def base_sub_refresh(name=''):
    path = profiles / 'base.json'
    obj = json.loads(path.read_bytes())
    subs = obj.get('subs') or []
    changed = 0
    for sub in subs:
        if name and sub.get('name') != name:
            continue
        try:
            nodes = sub_parse(fetch(sub['url']).decode('utf-8', 'replace'))
        except Exception:
            continue
        if nodes:
            sub['nodes'] = nodes
            changed += 1
    if changed:
        obj['nodeCount'] = len(base_all_nodes(obj))
        save(path, json.dumps(obj, ensure_ascii=False).encode())
        selected = (D / 'selected').read_text().strip() if (D / 'selected').exists() else ''
        if selected == 'base':
            install('base', True)
    return {'ok': True, 'updated': changed}


def ensure_base():
    path = profiles / 'base.json'
    if path.exists():
        return
    nodes = []
    try:
        selected = (D / 'selected').read_text().strip() if (D / 'selected').exists() else ''
        if selected and selected != 'base':
            nodes = node_objects(profile_config(json.loads((profiles / (selected + '.json')).read_bytes())))
    except Exception:
        nodes = []
    save(path, json.dumps({'base': True, 'nodes': nodes}, ensure_ascii=False).encode())


def count_nodes(obj):
    if 'base' in obj:
        return len(base_all_nodes(obj))
    if 'suburl' in obj:
        return len(obj.get('nodes') or [])
    if 'config' in obj:
        return len(node_list(obj['config']))
    return 0


def refresh_counts():
    for path in profiles.glob('*.json'):
        try:
            obj = json.loads(path.read_bytes())
        except Exception:
            continue
        count = count_nodes(obj)
        if 'url' in obj and count == 0:
            try:
                cfg = json.loads(json.dumps(obj['config'])) if obj.get('config') else json.loads(fetch(obj['url']))
                count = len(node_list(cfg)) + len(obj.get('nodes') or [])
            except Exception:
                pass
        obj['nodeCount'] = count
        save(path, json.dumps(obj, ensure_ascii=False).encode())
    return {'ok': True}


def set_token(arg):
    value = (arg.get('token') or '').strip() or secrets.token_urlsafe(32)
    if len(value) < 16:
        raise ValueError('密钥至少 16 个字符')
    if not re.fullmatch(r'[A-Za-z0-9_=+/.-]+', value):
        raise ValueError('密钥只能包含字母、数字和 _ = + / . -')
    save(D / 'token', value.encode())
    selected = (D / 'selected').read_text().strip() if (D / 'selected').exists() else ''
    if selected:
        install(selected, True)
    return {'token': value}


def add_nodes(cfg, nodes):
    out = cfg['outbounds']
    by_tag = {x.get('tag'): x for x in out}
    selector = next((x for x in out if x.get('tag') == 'PROXY' and x['type'] == 'selector'), None)
    if selector is None:
        selector = next((x for x in out if x['type'] == 'selector'), None)
    if selector is None:
        raise ValueError('当前配置没有手动选择组，请选择新建基础配置')
    groups = [selector] + [x for x in out if x['type'] == 'urltest' and x.get('tag') in selector['outbounds']]
    for x in nodes:
        tag = x.get('tag')
        if not tag or x.get('type') not in PROXY_TYPES or not x.get('server'):
            raise ValueError('节点格式无效')
        if tag in by_tag and by_tag[tag] != x:
            raise ValueError('节点名称冲突：' + tag)
        if tag not in by_tag:
            out.append(x)
            by_tag[tag] = x
        for g in groups:
            if tag not in g['outbounds']:
                g['outbounds'].append(tag)
    return cfg


def apply_node_edits(cfg, obj):
    deleted = set(obj.get('nodeDels') or [])
    overrides = obj.get('nodeOverrides') or {}
    renames = {}
    final = []
    for original in cfg.get('outbounds', []):
        old_tag = original.get('tag')
        replacement = overrides.get(old_tag)
        node = json.loads(json.dumps(replacement or original))
        new_tag = node.get('tag')
        renamed = replacement is not None and new_tag != old_tag
        if original.get('type') in PROXY_TYPES:
            if new_tag in deleted or (old_tag in deleted and not renamed):
                continue
            if renamed:
                renames[old_tag] = new_tag
        final.append(node)
    for old_tag, node in overrides.items():
        if not any(x.get('tag') == node.get('tag') for x in final) and old_tag not in deleted and node.get('tag') not in deleted:
            final.append(json.loads(json.dumps(node)))
    tags = {x.get('tag') for x in final}
    for group in final:
        if group.get('type') in ('selector', 'urltest'):
            group['outbounds'] = list(dict.fromkeys(renames.get(t, t) for t in group.get('outbounds', [])
                                                  if renames.get(t, t) in tags))
            default = renames.get(group.get('default'), group.get('default'))
            if default in group['outbounds']:
                group['default'] = default
            else:
                group.pop('default', None)
    cfg['outbounds'] = final
    return cfg


def profile_config(obj):
    if 'base' in obj:
        cfg = base_config([n for n, _ in base_all_nodes(obj)], base_mode())
    elif 'suburl' in obj:
        cfg = base_config(json.loads(json.dumps(obj.get('nodes', []))), base_mode())
    elif 'url' in obj:
        cfg = json.loads(json.dumps(obj['config'])) if obj.get('config') else json.loads(fetch(obj['url']))
        if obj.get('nodes'):
            add_nodes(cfg, obj['nodes'])
    else:
        cfg = json.loads(json.dumps(obj['config']))
        if obj.get('nodes'):
            add_nodes(cfg, obj['nodes'])
    return apply_node_edits(cfg, obj)


def node_list(cfg):
    result = []
    for x in cfg.get('outbounds', []):
        tag = x.get('tag')
        if x.get('type') in PROXY_TYPES and tag not in NON_NODE_TAGS:
            result.append({'tag': tag, 'type': x.get('type'), 'server': x.get('server', ''),
                           'port': x.get('server_port', 0)})
    return result


def b64decode_text(text):
    text = text.strip().replace('-', '+').replace('_', '/')
    text += '=' * (-len(text) % 4)
    try:
        return base64.b64decode(text).decode('utf-8', 'replace')
    except Exception:
        return ''


def parse_link(uri):
    if uri.startswith('vmess://'):
        raw = b64decode_text(uri[8:])
        o = json.loads(raw)
        tag = str(o.get('ps') or o.get('add'))
        out = {'type': 'vmess', 'tag': tag, 'server': o['add'], 'server_port': int(o['port']),
               'uuid': o['id'], 'alter_id': int(o.get('aid') or 0), 'security': o.get('scy') or 'auto'}
        if o.get('tls') in ('tls', 'reality'):
            out['tls'] = {'enabled': True, 'server_name': o.get('sni') or o.get('host') or o['add']}
        net = o.get('net') or 'tcp'
        if net == 'ws':
            out['transport'] = {'type': 'ws', 'path': o.get('path') or '/',
                                'headers': {'Host': o.get('host') or o['add']}}
        elif net == 'grpc':
            out['transport'] = {'type': 'grpc', 'service_name': o.get('path') or ''}
        return out
    if uri.startswith('ss://'):
        body = uri[5:]
        tag = ''
        if '#' in body:
            body, frag = body.split('#', 1)
            tag = urllib.parse.unquote(frag)
        body = body.split('?')[0]
        if '@' in body:
            user, hostpart = body.rsplit('@', 1)
            cred = b64decode_text(user) if ':' not in urllib.parse.unquote(user) else urllib.parse.unquote(user)
            host, port = hostpart.rsplit(':', 1)
        else:
            raw = b64decode_text(body)
            cred, hostpart = raw.rsplit('@', 1)
            host, port = hostpart.rsplit(':', 1)
        method, password = cred.split(':', 1)
        return {'type': 'shadowsocks', 'tag': tag or host, 'server': host, 'server_port': int(port),
                'method': method, 'password': password}
    if '://' not in uri:
        return None
    scheme, rest = uri.split('://', 1)
    if '#' in rest:
        rest, frag = rest.split('#', 1)
        tag = urllib.parse.unquote(frag)
    else:
        tag = ''
    if '?' in rest:
        body, query = rest.split('?', 1)
        q = urllib.parse.parse_qs(query)
    else:
        body, q = rest, {}
    userinfo, hostpart = (body.rsplit('@', 1) + [''])[:2] if '@' in body else ('', body)
    host, _, port = hostpart.rpartition(':')
    if not host:
        return None
    port = int(port)
    q1 = lambda k, d='': (q.get(k) or [d])[0]
    if scheme == 'vless':
        out = {'type': 'vless', 'tag': tag or host, 'server': host, 'server_port': port,
               'uuid': urllib.parse.unquote(userinfo)}
        security = q1('security')
        if security in ('tls', 'reality'):
            tls = {'enabled': True, 'server_name': q1('sni') or q1('host') or host}
            if q1('fp'):
                tls['utls'] = {'enabled': True, 'fingerprint': q1('fp')}
            if security == 'reality':
                tls['reality'] = {'enabled': True, 'public_key': q1('pbk')}
                if q1('sid'):
                    tls['reality']['short_id'] = q1('sid')
            out['tls'] = tls
        if q1('flow'):
            out['flow'] = q1('flow')
        transport = q1('type')
        if transport == 'ws':
            out['transport'] = {'type': 'ws', 'path': urllib.parse.unquote(q1('path', '/')),
                                'headers': {'Host': q1('host') or host}}
        elif transport == 'grpc':
            out['transport'] = {'type': 'grpc', 'service_name': q1('serviceName')}
        return out
    if scheme == 'trojan':
        out = {'type': 'trojan', 'tag': tag or host, 'server': host, 'server_port': port,
               'password': urllib.parse.unquote(userinfo)}
        sni = q1('sni') or q1('peer') or host
        out['tls'] = {'enabled': True, 'server_name': sni}
        if q1('allowInsecure') in ('1', 'true'):
            out['tls']['insecure'] = True
        if q1('type') == 'ws':
            out['transport'] = {'type': 'ws', 'path': urllib.parse.unquote(q1('path', '/')),
                                'headers': {'Host': q1('host') or sni}}
        return out
    if scheme in ('hysteria2', 'hy2'):
        out = {'type': 'hysteria2', 'tag': tag or host, 'server': host, 'server_port': port,
               'password': urllib.parse.unquote(userinfo)}
        out['tls'] = {'enabled': True, 'server_name': q1('sni') or host}
        if q1('insecure') in ('1', 'true'):
            out['tls']['insecure'] = True
        if q1('obfs'):
            out['obfs'] = {'type': q1('obfs'), 'password': q1('obfs-password')}
        if q1('alpn'):
            out['tls']['alpn'] = [x for x in q1('alpn').split(',') if x]
        return out
    if scheme == 'tuic':
        out = {'type': 'tuic', 'tag': tag or host, 'server': host, 'server_port': port,
               'uuid': urllib.parse.unquote(userinfo), 'password': q1('password')}
        out['tls'] = {'enabled': True, 'server_name': q1('sni') or host}
        return out
    return None


def sub_parse(text):
    raw = text.strip()
    nodes = []
    if raw.startswith('{') or raw.startswith('['):
        cfg = json.loads(raw)
        for x in (cfg.get('outbounds') or []):
            if x.get('type') in PROXY_TYPES and x.get('server'):
                node = json.loads(json.dumps(x))
                node.setdefault('tag', node['server'])
                nodes.append(node)
        return nodes
    if '://' not in raw:
        raw = b64decode_text(raw)
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        try:
            node = parse_link(line)
        except Exception:
            node = None
        if node and node.get('server'):
            nodes.append(node)
    tags = {}
    for n in nodes:
        base = n['tag']
        i = 2
        while n['tag'] in tags:
            n['tag'] = f'{base}-{i}'
            i += 1
        tags[n['tag']] = True
    return nodes


def profile_action(method, arg, name):
    path = profiles / (name + '.json')
    original = path.read_bytes() if path.exists() else None
    revision = hashlib.sha256(original or b'').hexdigest()
    if method == 'readprofile':
        if not original:
            raise ValueError('配置不存在')
        obj = json.loads(original)
        return dict(value=json.dumps(profile_config(obj), ensure_ascii=False, indent=2), revision=revision,
                    remote='url' in obj, url=obj.get('url',''))
    if method == 'editprofile':
        dest = arg['dest']
        validate(dest)
        if not original or revision != arg['revision']:
            raise ValueError('配置已改变，请重新打开编辑器')
        target = profiles / (dest + '.json')
        source_edit=arg.get('source',False)
        if source_edit:
            obj=json.loads(original)
            if 'url' not in obj:
                raise ValueError('只有链接配置可以修改来源链接')
            if target != path and target.exists():
                raise ValueError('目标名称已存在')
            url=arg.get('url','').strip()
            cfg=json.loads(fetch(url))
            if not isinstance(cfg,dict) or not isinstance(cfg.get('outbounds'),list):
                raise ValueError('该链接不是完整 sing-box 配置，请从导入入口添加节点')
            obj['url']=url
            obj['config']=cfg
            render(json.dumps(profile_config(obj)).encode())
            obj['nodeCount']=len(node_objects(profile_config(obj)))
            save(target,json.dumps(obj,ensure_ascii=False).encode())
            try:
                if dest==active_name():install(dest,True)
            except Exception:
                if target==path:save(path,original)
                else:target.unlink(missing_ok=True)
                raise
            return {'ok':True}
        if target == path and ('url' in json.loads(original) or 'suburl' in json.loads(original)):
            raise ValueError('订阅请另存为本地副本')
        if target != path and target.exists():
            raise ValueError('目标名称已存在')
        obj = {'config': json.loads(arg['value'])}
    elif method == 'nodes':
        nodes = json.loads(arg['value'])
        if not isinstance(nodes, list) or not nodes:
            raise ValueError('没有节点')
        target = path
        if arg['new']:
            if original:
                raise ValueError('名称已存在')
            obj = {'config': base_config(nodes)}
        else:
            if not original:
                raise ValueError('配置不存在')
            obj = json.loads(original)
            if 'url' in obj or 'suburl' in obj or 'base' in obj:
                extra = obj.setdefault('nodes', [])
                extra.extend(x for x in nodes if x not in extra)
            else:
                add_nodes(obj['config'], nodes)
    else:
        raise ValueError('未知配置操作')
    cfg = profile_config(obj)
    if not isinstance(cfg.get('outbounds'), list) or not cfg['outbounds']:
        raise ValueError('配置缺少 outbounds')
    render(json.dumps(cfg).encode())
    save(target, json.dumps(obj, ensure_ascii=False).encode())
    return {'ok': True}


