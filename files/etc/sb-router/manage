            return int(proc.name)
    return 0


def uptime_seconds():
    pid = core_pid()
    if not pid:
        return 0
    try:
        ticks = int(pathlib.Path(f'/proc/{pid}/stat').read_text().split()[21])
        hz = os.sysconf('SC_CLK_TCK')
        system_uptime = float(pathlib.Path('/proc/uptime').read_text().split()[0])
        return max(0, int(system_uptime - ticks / hz))
    except Exception:
        return 0


