def node_key(profile, source, original):
    return hashlib.sha256(json.dumps([profile, source, original], ensure_ascii=False).encode()).hexdigest()[:24]

def base_entries(obj):
    entries = []
    used = set()
    sources = [('', obj.get('nodes') or [], {}, [])]
    for sub in obj.get('subs') or []:
        sources.append((sub['name'], sub.get('nodes') or [], sub.get('overrides') or {}, sub.get('deleted') or []))
    for source, nodes, overrides, deleted in sources:
        for index, original in enumerate(nodes):
            original_tag = original.get('tag') or original.get('server') or ('node-' + str(index))
            if original_tag in deleted:
                continue
            node = json.loads(json.dumps(overrides.get(original_tag, original)))
            tag = node.get('tag') or original_tag
            if tag in used:
                suffix = hashlib.sha256((source + original_tag).encode()).hexdigest()[:6]
                tag = tag + '-' + suffix
            if tag in used:
                raise ValueError('同一来源存在重复节点名称')
            used.add(tag)
            node['tag'] = tag
            entries.append({'id': node_key('base', source, original_tag), 'owner': 'base',
                            'source': source, 'original': original_tag, 'node': node})
    return entries

def base_all_nodes(obj):
    return [(x['node'], x['source']) for x in base_entries(obj)]

