def node_set(name, tag, value):
    path = profiles / (name + '.json')
    original = json.loads(path.read_bytes())
    cfg = profile_config(original)
    node = json.loads(value)
    if node.get('type') not in PROXY_TYPES or not node.get('server'):
        raise ValueError('节点格式无效')
    new_tag = node.get('tag') or tag
    idx = next((i for i, x in enumerate(cfg['outbounds']) if x.get('tag') == tag), -1)
    if idx < 0:
        raise ValueError('节点不存在')
    cfg['outbounds'][idx] = node
    if new_tag != tag:
        for x in cfg['outbounds']:
            if x.get('type') in ('selector', 'urltest'):
                x['outbounds'] = [new_tag if t == tag else t for t in x.get('outbounds', [])]
                if x.get('default') == tag:
                    x['default'] = new_tag
    render(json.dumps(cfg).encode())
    target = path
    if 'url' in original or 'suburl' in original or 'base' in original:
        original.setdefault('nodeOverrides', {})[tag] = node
        if new_tag != tag:
            dels = original.setdefault('nodeDels', [])
            if tag not in dels:
                dels.append(tag)
    else:
        original['config'] = cfg
    save(target, json.dumps(original, ensure_ascii=False).encode())
    return {'ok': True}


def node_del(name, tag):
    path = profiles / (name + '.json')
    original = json.loads(path.read_bytes())
    cfg = profile_config(original)
    if not any(x.get('tag') == tag and x.get('type') in PROXY_TYPES for x in cfg['outbounds']):
        raise ValueError('节点不存在')
    cfg['outbounds'] = [x for x in cfg['outbounds'] if x.get('tag') != tag]
    for x in cfg['outbounds']:
        if x.get('type') in ('selector', 'urltest'):
            x['outbounds'] = [t for t in x.get('outbounds', []) if t != tag]
            if x.get('default') == tag:
                x['default'] = x['outbounds'][0] if x['outbounds'] else ''
    render(json.dumps(cfg).encode())
    if 'url' in original or 'suburl' in original or 'base' in original:
        dels = original.setdefault('nodeDels', [])
        if tag not in dels:
            dels.append(tag)
        original.get('nodeOverrides', {}).pop(tag, None)
    else:
        original['config'] = cfg
    save(path, json.dumps(original, ensure_ascii=False).encode())
    return {'ok': True}


