def change_catalog(arg, delete=False):
    entry = find_entry(arg['id'])
    if not entry:
        raise ValueError('节点已改变，请刷新列表')
    if entry['owner'] != 'base':
        return node_del(entry['owner'], entry['original']) if delete else node_set(entry['owner'], entry['original'], arg['value'])
    obj = read_obj('base')
    source = entry['source']
    original = entry['original']
    if not delete:
        node = json.loads(arg['value'])
        validate_node(node)
    if source:
        sub = next(x for x in obj['subs'] if x['name'] == source)
        if delete:
            sub.setdefault('deleted', []).append(original)
            sub.get('overrides', {}).pop(original, None)
        else:
            sub.setdefault('overrides', {})[original] = node
    else:
        idx = next(i for i, n in enumerate(obj['nodes']) if (n.get('tag') or n.get('server')) == original)
        if delete:
            obj['nodes'].pop(idx)
        else:
            obj['nodes'][idx] = node
    if base_all_nodes(obj):
        write_profile('base', obj)
    elif active_name() == 'base':
        raise ValueError('正在使用的基础配置至少保留一个节点')
    else:
        obj['nodeCount'] = 0
        save(profiles / 'base.json', json.dumps(obj, ensure_ascii=False).encode())
    return {'ok': True}

def validate_node(node):
    if node.get('type') not in PROXY_TYPES or not isinstance(node.get('server'), str) or not node['server'].strip():
        raise ValueError('节点协议或服务器地址无效')
    if not isinstance(node.get('tag'), str) or not node['tag'].strip():
        raise ValueError('请填写节点名称')
    if not isinstance(node.get('server_port'), int) or not 1 <= node['server_port'] <= 65535:
        raise ValueError('节点端口无效')
    if node['type'] in ('vmess', 'vless', 'tuic') and not node.get('uuid'):
        raise ValueError('请填写 UUID')
    if node['type'] in ('trojan', 'hysteria2', 'shadowsocks') and not node.get('password'):
        raise ValueError('请填写密码')
    probe = {'outbounds': [node, {'type': 'direct', 'tag': '_validation-direct'}],
             'dns': {'servers': [dict(type='udp', tag='local', server='223.5.5.5')]},
             'route': {'final': '_validation-direct', 'default_domain_resolver': 'local'}}
    check(probe)

def clash_node(x):
    typ = {'ss': 'shadowsocks', 'hy2': 'hysteria2'}.get(x.get('type'), x.get('type'))
    if typ not in ('shadowsocks', 'vmess', 'vless', 'trojan', 'hysteria2', 'tuic', 'anytls'):
        raise ValueError('不支持的 Clash 节点协议：' + str(x.get('type')))
    n = dict(type=typ, tag=str(x.get('name') or x['server']), server=x['server'], server_port=int(x['port']))
    for field in ('password', 'uuid', 'flow', 'username'):
        if x.get(field) is not None:
            n[field] = str(x[field])
    if typ == 'shadowsocks':
        n['method'] = x['cipher']
        if x.get('plugin'):
            raise ValueError('请将带插件的 Shadowsocks 节点转换为完整 sing-box 配置')
    if typ == 'vmess':
        n['security'] = x.get('cipher', 'auto')
        n['alter_id'] = int(x.get('alterId', 0))
    if x.get('tls') or typ in ('trojan', 'hysteria2', 'tuic', 'anytls'):
        n['tls'] = {'enabled': True, 'server_name': x.get('servername') or x.get('sni') or x['server']}
        if x.get('skip-cert-verify'):
            n['tls']['insecure'] = True
        if x.get('alpn'):
            n['tls']['alpn'] = x['alpn']
        if x.get('client-fingerprint'):
            n['tls']['utls'] = {'enabled': True, 'fingerprint': x['client-fingerprint']}
        if x.get('reality-opts'):
            r = x['reality-opts']
            n['tls']['reality'] = {'enabled': True, 'public_key': r['public-key'], 'short_id': r.get('short-id', '')}
    network = x.get('network', 'tcp')
    if network == 'ws':
        opts = x.get('ws-opts', {})
        n['transport'] = {'type': 'ws', 'path': opts.get('path', '/'), 'headers': opts.get('headers', {})}
    elif network == 'grpc':
        n['transport'] = {'type': 'grpc', 'service_name': x.get('grpc-opts', {}).get('grpc-service-name', '')}
    elif network not in ('tcp', ''):
        raise ValueError('暂不支持此 Clash 传输方式：' + network)
    if typ == 'hysteria2' and x.get('obfs'):
        n['obfs'] = {'type': x['obfs'], 'password': x.get('obfs-password', '')}
    return n

original_parse_link = parse_link
def parse_link(uri):
    parts = urllib.parse.urlsplit(uri)
    scheme = parts.scheme.lower()
    if scheme in ('vmess', 'ss'):
        query = urllib.parse.parse_qs(parts.query)
        if scheme == 'ss' and any(k in query for k in ('plugin', 'plugin-opts', 'plugin_opts')):
            raise ValueError('此 Shadowsocks 分享链接使用插件，请导入完整配置')
        node = original_parse_link(uri)
        if node:
            node['server'] = node['server'].strip('[]')
        return node
    if scheme not in ('vless', 'trojan', 'hy2', 'hysteria2', 'tuic', 'anytls'):
        raise ValueError('不支持的节点分享协议')
    query = urllib.parse.parse_qs(parts.query)
    def param(key, default=''):
        return (query.get(key) or [default])[0]
    authority = parts.netloc
    if '@' not in authority or not parts.hostname:
        raise ValueError('节点链接缺少凭据或服务器')
    credential = urllib.parse.unquote(authority.rsplit('@', 1)[0])
    typ = 'hysteria2' if scheme == 'hy2' else scheme
    node = dict(type=typ, tag=urllib.parse.unquote(parts.fragment) or parts.hostname,
                server=parts.hostname, server_port=parts.port or (443 if typ in ('hysteria2', 'tuic') else 0))
    if typ == 'vless':
        node['uuid'] = credential
        if param('flow'):
            node['flow'] = param('flow')
    elif typ == 'tuic':
        uuid, separator, password = credential.partition(':')
        node.update(uuid=uuid, password=password if separator else param('password'))
    else:
        node['password'] = credential
    security = param('security', 'none' if typ == 'vless' else 'tls')
    if security not in ('none', 'tls', 'reality', ''):
        raise ValueError('不支持的 TLS 方式')
    if security in ('tls', 'reality') or typ in ('trojan', 'hysteria2', 'tuic', 'anytls'):
        tls = dict(enabled=True, server_name=param('sni') or param('peer') or parts.hostname)
        if any(param(k).lower() in ('1', 'true') for k in ('insecure', 'allowInsecure')):
            tls['insecure'] = True
        if param('alpn'):
            tls['alpn'] = param('alpn').split(',')
        if param('fp'):
            tls['utls'] = dict(enabled=True, fingerprint=param('fp'))
        if security == 'reality':
            tls['reality'] = dict(enabled=True, public_key=param('pbk'), short_id=param('sid'))
        node['tls'] = tls
    transport = param('type', 'tcp')
    if transport in ('ws', 'httpupgrade'):
        node['transport'] = dict(type=transport, path=param('path', '/'))
        if param('host'):
            if transport == 'httpupgrade':
                node['transport']['host'] = param('host')
            else:
                node['transport']['headers'] = {'Host': param('host')}
    elif transport == 'grpc':
        node['transport'] = dict(type='grpc', service_name=param('serviceName'))
    elif transport not in ('tcp', ''):
        raise ValueError('不支持的传输方式')
    if typ == 'hysteria2' and param('obfs'):
        node['obfs'] = dict(type=param('obfs'), password=param('obfs-password'))
    return node

def sub_parse(text):
    text = text.lstrip('﻿').strip()
    if not text:
        raise ValueError('导入内容为空')
    if text.startswith(('{', '[')):
        data = json.loads(text)
        if isinstance(data, list):
            nodes = data
        elif isinstance(data.get('outbounds'), list):
            nodes = node_objects(data)
        elif isinstance(data.get('proxies'), list):
            nodes = [clash_node(x) for x in data['proxies']]
        elif data.get('type') in PROXY_TYPES:
            nodes = [data]
        else:
            raise ValueError('JSON 中未找到代理节点')
    elif re.search(r'(?m)^s*proxiess*:', text):
        import yaml
        data = yaml.safe_load(text)
        nodes = [clash_node(x) for x in data.get('proxies') or []]
    else:
        decoded = text if '://' in text else b64decode_text(text)
        nodes = []
        for line in decoded.splitlines():
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            try:
                n = parse_link(line)
                if not n:
                    raise ValueError('不支持的分享协议')
                n['server'] = n['server'].strip('[]')
                nodes.append(n)
            except Exception:
                raise ValueError('分享链接无法解析，请检查协议和参数')
    if not nodes:
        raise ValueError('内容中没有可导入的节点')
    seen = set()
    for n in nodes:
        n.setdefault('tag', n.get('server', 'node'))
        tag, i = n['tag'], 2
        while n['tag'] in seen:
            n['tag'] = tag + '-' + str(i)
            i += 1
        seen.add(n['tag'])
    return nodes

def inspect_import(arg):
    IMPORT_DIR.mkdir(mode=0o700, exist_ok=True)
    for p in IMPORT_DIR.glob('*.json'):
        if time.time() - p.stat().st_mtime > 900:
            p.unlink()
    url = arg.get('url', '').strip()
    raw = fetch(url).decode('utf-8-sig') if url else arg.get('value', '').lstrip('﻿')
    if len(raw.encode()) > 8 * 1024 * 1024:
        raise ValueError('导入文件过大，最大支持 8 MiB')
    try:
        parsed = json.loads(raw)
    except ValueError:
        parsed = None
    is_config = isinstance(parsed, dict) and isinstance(parsed.get('outbounds'), list)
    nodes = node_objects(parsed) if is_config else sub_parse(raw)
    ticket = secrets.token_hex(16)
    save(IMPORT_DIR / (ticket + '.json'), json.dumps({'raw': raw, 'url': url, 'config': is_config}).encode())
    return {'ticket': ticket, 'isConfig': is_config, 'count': len(nodes), 'source': 'link' if url else 'file'}

def commit_import(arg):
    ticket = arg['ticket']
    if not re.fullmatch('[0-9a-f]{32}', ticket):
        raise ValueError('导入凭证无效')
    p = IMPORT_DIR / (ticket + '.json')
    if not p.exists() or time.time() - p.stat().st_mtime > 900:
        raise ValueError('导入预览已过期，请重新选择')
    data = json.loads(p.read_bytes())
    name = arg['name'].strip()
    validate(name)
    mode = arg['mode']
    if mode == 'config':
        if not data['config']:
            raise ValueError('此文件仅支持导入节点')
        if (profiles / (name + '.json')).exists():
            raise ValueError('配置名称已存在')
        cfg = json.loads(data['raw'])
        obj = {'config': cfg}
        if data['url']:
            obj['url'] = data['url']
        write_profile(name, obj, False)
    elif mode == 'nodes':
        nodes = sub_parse(data['raw'])
        for n in nodes:
            validate_node(n)
        obj = read_obj('base')
        if data['url']:
            subs = obj.setdefault('subs', [])
            if any(s['name'] == name for s in subs):
                raise ValueError('订阅名称已存在')
            subs.append(dict(name=name, url=data['url'], nodes=nodes))
        else:
            existing = {n.get('tag') for n in obj.get('nodes', [])}
            if any(n['tag'] in existing for n in nodes):
                raise ValueError('手动节点名称重复，请更改名称')
            obj.setdefault('nodes', []).extend(nodes)
        write_profile('base', obj)
    else:
        raise ValueError('导入方式无效')
    p.unlink()
    return {'ok': True}

def add_manual_node(arg):
    node = json.loads(arg['value'])
    validate_node(node)
    obj = read_obj('base')
    if any(n.get('tag') == node['tag'] for n in obj.get('nodes', [])):
        raise ValueError('手动节点名称已存在')
    obj.setdefault('nodes', []).append(node)
    write_profile('base', obj)
    return {'ok': True}

def probe_catalog(scope):
    entries = catalog()
    if scope and scope != 'all':
        entries = [x for x in entries if ('base:' + x['source'] if x['owner'] == 'base' else 'profile:' + x['owner']) == scope]
    if not entries:
        return {'delays': {}}
    with tempfile.TemporaryDirectory(prefix='sb-probe-', dir='/tmp') as td:
        root = pathlib.Path(td)
        with socket.socket() as sock:
            sock.bind(('127.0.0.1', 0))
            port = sock.getsockname()[1]
        nodes = []
        for entry in entries:
            n = json.loads(json.dumps(entry['node']))
            n['tag'] = entry['id']
            nodes.append(n)
        cfg = {'log': {'level': 'error'}, 'outbounds': nodes + [dict(type='direct', tag='_probe-direct')],
               'dns': {'servers': [dict(type='udp', tag='local', server='223.5.5.5')]},
               'route': {'final': '_probe-direct', 'default_domain_resolver': {'server': 'local', 'strategy': 'ipv4_only'}, 'default_mark': 0x2024},
               'experimental': {'clash_api': {'external_controller': '127.0.0.1:' + str(port)}}}
        path = root / 'probe.json'
        path.write_text(json.dumps(cfg))
        with (root / 'log').open('w') as log:
            proc = sp.Popen([str(D / 'core'), 'run', '-D', td, '-c', str(path)], stdout=log, stderr=log)
        def request(suffix):
            r = sp.run(['curl', '-fsS', '--max-time', '8', 'http://127.0.0.1:' + str(port) + suffix], capture_output=True)
            if r.returncode:
                raise ValueError('测速连接失败')
            return json.loads(r.stdout)
        try:
            for _ in range(35):
                if proc.poll() is not None:
                    raise ValueError('测速内核启动失败，请检查节点参数')
                try:
                    request('/version')
                    break
                except Exception:
                    time.sleep(.15)
            def probe(entry):
                for attempt in range(2):
                    try:
                        url = '/proxies/' + entry['id'] + '/delay?timeout=5000&url=https%3A%2F%2Fwww.gstatic.com%2Fgenerate_204'
                        delay = int(request(url).get('delay', 0))
                        if delay > 0:
                            return entry['id'], delay
                    except Exception:
                        pass
                return entry['id'], -1
            with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
                values = dict(pool.map(probe, entries))
            return {'delays': values}
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except sp.TimeoutExpired:
                proc.kill()
                proc.wait()

def update_items():
    subs = read_obj('base').get('subs', [])
    items = [dict(id='sub:' + s['name'], name=s['name'], kind='订阅节点') for s in subs]
    for p in profiles_info():
        if p['kind'] in ('remote', 'subscription'):
            items.append(dict(id='profile:' + p['name'], name=p['name'], kind='配置' if p['kind'] == 'remote' else '订阅节点'))
    return items

def update_options():
    items = update_items()
    saved = json.loads(UPDATE_FILE.read_bytes()) if UPDATE_FILE.exists() else None
    if saved is None:
        chosen = [x['id'] for x in items]
    else:
        chosen = [x for x in saved.get('selected', []) if x in {i['id'] for i in items}]
    return {'items': items, 'selected': chosen, 'schedule': schedule('unified')}

def save_update_selection(value):
    selected = json.loads(value)
    allowed = {x['id'] for x in update_items()}
    if not isinstance(selected, list) or any(not isinstance(x, str) or x not in allowed for x in selected):
        raise ValueError('更新选择已改变，请刷新后重试')
    save(UPDATE_FILE, json.dumps({'selected': list(dict.fromkeys(selected))}, ensure_ascii=False).encode())
    return {'ok': True}

def update_selected():
    chosen = update_options()['selected']
    old_base = read_obj('base')
    updated_base = json.loads(json.dumps(old_base))
    staged = {}
    errors = []
    successful = []
    for identity in chosen:
        try:
            kind, name = identity.split(':', 1)
            if kind == 'sub':
                sub = next(x for x in updated_base['subs'] if x['name'] == name)
                nodes = sub_parse(fetch(sub['url']).decode('utf-8-sig'))
                for n in nodes:
                    validate_node(n)
                sub['nodes'] = nodes
            else:
                obj = read_obj(name)
                if 'suburl' in obj:
                    obj['nodes'] = sub_parse(fetch(obj['suburl']).decode('utf-8-sig'))
                else:
                    obj['config'] = json.loads(fetch(obj['url']))
                render(json.dumps(profile_config(obj)).encode())
                staged[name] = obj
            successful.append(identity)
        except Exception as exc:
            errors.append({'id': identity, 'error': str(exc)})
    backups = {}
    if updated_base != old_base:
        staged['base'] = updated_base
    active = active_name()
    try:
        for name, obj in staged.items():
            path = profiles / (name + '.json')
            backups[name] = path.read_bytes()
            obj['nodeCount'] = len(node_objects(profile_config(obj)))
            save(path, json.dumps(obj, ensure_ascii=False).encode())
        if active in staged:
            install(active, True)
    except Exception:
        for name, raw in backups.items():
            save(profiles / (name + '.json'), raw)
        raise
    return {'ok': not errors, 'updated': successful, 'failures': errors}

