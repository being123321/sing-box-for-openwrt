def save_update_policy(arg):
    before = UPDATE_FILE.read_bytes() if UPDATE_FILE.exists() else None
    cron = pathlib.Path('/etc/crontabs/root').read_bytes()
    try:
        save_update_selection(arg['selected'])
        lines = [line for line in cron.decode().splitlines()
                 if line.split()[5:8] not in [CRONS['nodes'].split(), CRONS['config'].split()]]
        sp.run(['crontab', '-'], input=('\n'.join(lines) + '\n').encode(), check=True)
        set_schedule('unified', arg)
    except Exception:
        sp.run(['crontab', '-'], input=cron, check=True)
        if before is None:
            UPDATE_FILE.unlink(missing_ok=True)
        else:
            save(UPDATE_FILE, before)
        raise
    return {'ok': True}

def configure_strict_route():
    path = D / 'tun.json'
    cfg = json.loads(path.read_bytes())
    for inbound in cfg['inbounds']:
        if inbound['type'] == 'tun':
            inbound['strict_route'] = True
    tmp = D / 'tun-strict.json'
    save(tmp, json.dumps(cfg).encode())
    r = sp.run([str(D / 'core'), 'check', '-D', str(D), '-c', str(tmp)], capture_output=True)
    if r.returncode:
        raise ValueError('严格路由校验失败')
    os.replace(tmp, path)


def action(method, arg):
    name = arg.get('name', '')
    if method == 'catalog':
        return catalog_public()
    if method == 'catalog-get':
        entry = find_entry(arg['id'])
        if not entry:
            raise ValueError('节点已改变，请刷新')
        return {'value': json.dumps(entry['node'], ensure_ascii=False), 'id': entry['id']}
    if method == 'catalog-set':
        return change_catalog(arg)
    if method == 'catalog-del':
        return change_catalog(arg, True)
    if method == 'manual-add':
        return add_manual_node(arg)
    if method == 'import-inspect':
        return inspect_import(arg)
    if method == 'import-commit':
        return commit_import(arg)
    if method == 'catalog-delay':
        return probe_catalog(arg.get('scope', 'all'))
    if method == 'update-options':
        return update_options()
    if method == 'update-selection':
        return save_update_selection(arg['selected'])
    if method == 'update-policy':
        return save_update_policy(arg)
    if method in ('update-selected', 'refresh-selected', 'refresh-nodes', 'refresh-config'):
        return update_selected()
    if method == 'strict-route':
        configure_strict_route()
        return {'ok': True}
    if method == 'status':
        try:
            ensure_base()
        except Exception:
            pass
        return dict(schedules={'nodes': schedule('nodes'), 'config': schedule('config')},
                    baseMode=base_mode(), updates=update_options(),
                    schedule=schedule('nodes'),
                    autostart=sp.run([INIT, 'enabled'], capture_output=True).returncode == 0,
                    profiles=[p['name'] for p in profiles_info()],
                    profileList=profiles_info(),
                    active=(D / 'selected').read_text() if (D / 'selected').exists() else '',
                    running=pathlib.Path('/sys/class/net/sb-zh').exists(),
                    uptime=uptime_seconds(), kernel=kernel_version(), panel=panel_state(),
                    coreUpdate=__import__('core_update').preferences())
    if method == 'token':
        return {'token': (D / 'token').read_text()}
    if method == 'schedule':
        return set_schedule(arg.get('kind', 'nodes'), arg)
    if method == 'autostart':
        sp.run([INIT, 'enable' if arg['enabled'] else 'disable'], check=True)
        return {'ok': True}
    if method in ('start', 'stop'):
        return control(method == 'start')
    if method == 'restart':
        return restart_service()
    if method == 'refresh':
        name = (D / 'selected').read_text().strip()
    if method == 'refresh-nodes':
        return refresh_nodes() or {'ok': True}
    if method == 'refresh-config':
        return refresh_config() or {'ok': True}
    if method == 'kernel':
        from core_update import handle
        return handle(arg)
    if method == 'profiles':
        return {'profiles': profiles_info()}
    if method == 'logs':
        return logs(arg)
    if method == 'refresh-counts':
        return refresh_counts()
    if method == 'sub-list':
        return base_sub_list()
    if method == 'sub-add':
        return base_sub_add(arg.get('name', ''), arg.get('url', ''))
    if method == 'sub-del':
        return base_sub_del(arg.get('name', ''))
    if method == 'sub-refresh':
        return base_sub_refresh(arg.get('name', ''))
    if method == 'base-mode':
        if arg.get('mode'):
            return set_base_mode(arg['mode'])
        return {'mode': base_mode()}
    if method == 'token-set':
        return set_token(arg)
    if method == 'panel':
        return panel_state()
    if method == 'panel-set':
        return panel_set(arg)
    validate(name)
    if method in ('readprofile', 'editprofile', 'nodes'):
        return profile_action(method, arg, name)
    if method in ('node-list', 'node-delay', 'node-get', 'node-set', 'node-del'):
        if method == 'node-list':
            obj = json.loads((profiles / (name + '.json')).read_bytes())
            if 'base' in obj:
                return {'nodes': [{'tag': n['tag'], 'type': n['type'], 'server': n.get('server', ''),
                                   'port': n.get('server_port', 0), 'source': src}
                                  for n, src in base_all_nodes(obj)]}
            return {'nodes': node_list(profile_config(obj))}
        if method == 'node-delay':
            return node_delays(name)
        if method == 'node-get':
            return node_get(name, arg['tag'])
        if method == 'node-set':
            return node_set(name, arg['tag'], arg['value'])
        return node_del(name, arg['tag'])
    if method == 'delete':
        return profile_delete(name)
    if method == 'sublink':
        return sublink(name, arg['url'], arg.get('new', False))
    if method in ('link', 'upload'):
        if method == 'link':
            obj = {'url': arg['value']}
            raw = fetch(obj['url'])
        else:
            obj = {'config': json.loads(arg['value'])}
            raw = arg['value'].encode()
        if not isinstance(json.loads(raw).get('outbounds'), list):
            raise ValueError('需要完整 sing-box JSON')
        render(raw)
        save(profiles / (name + '.json'), json.dumps(obj, ensure_ascii=False).encode())
    elif method in ('apply', 'refresh'):
        install(name, True)
    elif method == 'prepare':
        install(name, False)
        os.replace(D / 'candidate.json', D / 'active.json')
    else:
        raise ValueError('unknown method')
    return {'ok': True}


