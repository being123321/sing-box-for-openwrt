def schedule(kind):
    cmd = CRONS[kind].split()
    for line in pathlib.Path('/etc/crontabs/root').read_text().splitlines():
        fields = line.split()
        if len(fields) < 8 or fields[5:8] != cmd:
            continue
        if not (fields[0].isdigit() and fields[1].isdigit()):
            continue
        minute, hour, dom, mon, dow = fields[:5]
        base = {'enabled': True, 'hour': int(hour), 'minute': int(minute), 'weekday': 1, 'day': 1}
        if dow != '*' and dow.isdigit():
            return dict(base, mode='weekly', weekday=int(dow))
        if dom != '*' and dom.isdigit():
            return dict(base, mode='monthly', day=int(dom))
        return dict(base, mode='daily')
    return {'enabled': False, 'mode': 'daily', 'weekday': 1, 'day': 1, 'hour': 2, 'minute': 0}


def set_schedule(kind, arg):
    if kind not in CRONS:
        raise ValueError('更新类型无效')
    h = int(arg['hour'])
    m = int(arg['minute'])
    if not 0 <= h < 24 or not 0 <= m < 60:
        raise ValueError('时间无效')
    mode = arg.get('mode', 'daily')
    if mode not in ('daily', 'weekly', 'monthly'):
        raise ValueError('更新周期无效')
    weekday = int(arg.get('weekday', 1))
    day = int(arg.get('day', 1))
    if mode == 'weekly' and not 0 <= weekday <= 6:
        raise ValueError('星期无效')
    if mode == 'monthly' and not 1 <= day <= 31:
        raise ValueError('日期无效')
    if mode == 'weekly':
        expr = f'{m} {h} * * {weekday}'
    elif mode == 'monthly':
        expr = f'{m} {h} {day} * *'
    else:
        expr = f'{m} {h} * * *'
    path = pathlib.Path('/etc/crontabs/root')
    cmd = CRONS[kind].split()
    lines = [line for line in path.read_text().splitlines() if line.split()[5:8] != cmd]
    if arg['enabled']:
        lines.append(f'{expr} {CRONS[kind]} >{CRON_LOGS[kind]} 2>&1')
    payload = ('\n'.join(lines) + '\n').encode()
    sp.run(['crontab', '-'], input=payload, check=True)
    return {'ok': True}


def control(start):
    running = pathlib.Path('/sys/class/net/sb-zh').exists()
    if start and running:
